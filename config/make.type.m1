include config/make.type.hydro

# Turn on Radiative Transfer
DFLAGS += -DRT -DM1
DFLAGS += -DCHEMISTRY_GPU

# Output abundances
DFLAGS += -DOUTPUT_CHEMISTRY
# Output radiation fields
DFLAGS += -DOUTPUT_RADIATION

# adjust hydro integrator
DFLAGS := $(filter-out -DPLMC -DPPMP -DVL, $(DFLAGS))
DFLAGS += -DSIMPLE
DFLAGS += -DPLMP
